{
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "0 17 * * *"
    }
  ],
  "regions": ["fra1"],
  "functions": {
    "api/analyze.js": { "maxDuration": 300 },
    "api/send-reminders.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://vercel.live; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src https://*.stripe.com https://vercel.live blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" }
      ]
    }
  ],
  "redirects": [
    { "source": "/cooperative", "destination": "/organizzazioni", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/privacy-medici", "destination": "/privacy-medici.html" },
    { "source": "/termini-di-servizio", "destination": "/termini-di-servizio.html" },
    { "source": "/dpa", "destination": "/dpa.html" },
    { "source": "/sub-responsabili", "destination": "/sub-responsabili.html" },
    { "source": "/m/(.*)", "destination": "/api/medico?slug=$1" },
    { "source": "/c/(.*)", "destination": "/medidesk.html" },
    { "source": "/p/(.*)", "destination": "/medidesk.html" },
    { "source": "/t/(.*)", "destination": "/medidesk.html" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/organizzazioni", "destination": "/cooperativa.html" },
    { "source": "/((?!api/).*)", "destination": "/medidesk.html" }
  ]
}